# Base URL of the backend API (no trailing slash, without /api — that prefix
# is added automatically by the frontend, e.g. `${REACT_APP_BACKEND_URL}/api`).
# Local development:
#   REACT_APP_BACKEND_URL=http://localhost:8000
# Production (replace with your real domain):
#   REACT_APP_BACKEND_URL=https://aaa-razval.ru
REACT_APP_BACKEND_URL=https://aaa-razval.ru

# Dev-server-only setting — safe to leave as-is.
WDS_SOCKET_PORT=443
