# MongoDB connection string. For local development a plain local instance is
# fine; in production use your provider's connection string (with auth).
MONGO_URL="mongodb://localhost:27017"

# Database name used inside MongoDB.
DB_NAME="aaa_razval"

# Comma-separated list of allowed frontend origins for CORS.
# Example for production: "https://aaa-razval.ru,https://www.aaa-razval.ru"
CORS_ORIGINS="https://aaa-razval.ru,https://www.aaa-razval.ru"

# Credentials for the admin-only GET /api/bookings endpoint (HTTP Basic Auth).
# Set these to strong, unique values before deploying — the endpoint refuses
# all requests (503) if either is left empty.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"
